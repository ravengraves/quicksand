cc = cc
ar = ar
ninja = ninja
clang = clang
clang_tidy = clang-tidy
gcc_analyzer = gcc
cflags = -O3 -g -Wall -Wextra -std=c11 -fPIC
cppflags = -Iinclude
ldflags =
ldlibs = -lm
package_version = 1.0.0
scdoc = scdoc
sanitizers = address,undefined

rule mkdir
  command = mkdir -p $out

rule cc
  command = $cc $cppflags $cflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc

rule cc_timestamp
  command = arch=`uname -m`; if [ "$$arch" = arm64 ]; then arch=aarch64; fi; src=src/timestamp+$$arch.s; test -f $$src && $cc $cppflags $cflags -MMD -MF $out.d -c $$src -o $out
  depfile = $out.d
  deps = gcc

rule link_shared
  command = $cc -shared -o $out $in $ldflags $ldlibs

rule archive
  command = rm -f $out && $ar rcs $out $in

rule link_exe
  command = $cc $cppflags $cflags -o $out $in $ldflags $ldlibs

rule run_check
  command = ./build/test/basic && ./build/test/time && touch $out

rule copy_docs
  command = mkdir -p build/docs && cp $in build/docs/ && touch $out

rule scdoc
  command = mkdir -p `dirname $out` && $scdoc < $in > $out

rule gen_pc
  command = sed -e 's|@PREFIX@|$${PREFIX:-/usr/local}|g' -e 's|@LIBDIR@|$${LIBDIR:-$${PREFIX:-/usr/local}/lib}|g' -e 's|@INCLUDEDIR@|$${INCLUDEDIR:-$${PREFIX:-/usr/local}/include}|g' -e 's|@VERSION@|$package_version|g' $in > $out

rule install_lib
  command = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; install -d $$dest$$prefix/lib $$dest$$prefix/include $$dest$$prefix/lib/pkgconfig && install -m 0644 build/libquicksand.so $$dest$$prefix/lib/ && install -m 0644 build/libquicksand.a $$dest$$prefix/lib/ && install -m 0644 include/quicksand.h $$dest$$prefix/include/ && install -m 0644 include/quicksand_style.h $$dest$$prefix/include/ && install -m 0644 build/quicksand.pc $$dest$$prefix/lib/pkgconfig/ && touch $out

rule install_docs
  command = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; install -d $$dest$$prefix/share/doc/quicksand $$dest$$prefix/share/man/man3 && install -m 0644 docs/*.md $$dest$$prefix/share/doc/quicksand/ && install -m 0644 build/docs/quicksand.3 $$dest$$prefix/share/man/man3/ && touch $out

rule uninstall_lib
  command = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; rm -f $$dest$$prefix/lib/libquicksand.so $$dest$$prefix/lib/libquicksand.a $$dest$$prefix/include/quicksand.h $$dest$$prefix/include/quicksand_style.h $$dest$$prefix/lib/pkgconfig/quicksand.pc && touch $out

rule uninstall_docs
  command = prefix=$${PREFIX:-/usr/local}; dest=$${DESTDIR:-}; rm -f $$dest$$prefix/share/doc/quicksand/*.md $$dest$$prefix/share/man/man3/quicksand.3; rmdir $$dest$$prefix/share/doc/quicksand 2>/dev/null || true; touch $out

rule do_clean
  command = rm -rf build build-sanitize && rm -f compile_commands.json $out

rule gen_compdb
  command = $ninja -f build.ninja -t compdb cc cc_timestamp link_exe > $out
  generator = 1

rule delegate_make
  command = make $target && touch $out

build build: mkdir
build build/test: mkdir

build build/quicksand.o: cc src/quicksand.c | build
build build/time.o: cc src/time.c | build
build build/timestamp.o: cc_timestamp | build

build build/libquicksand.so: link_shared build/quicksand.o build/time.o build/timestamp.o
build build/libquicksand.a: archive build/quicksand.o build/time.o build/timestamp.o

build build/test/basic: link_exe test/test_basic.c build/libquicksand.a | build/test
build build/test/time: link_exe test/test_time.c build/libquicksand.a | build/test
build build/test/pub: link_exe test/test_pub.c build/libquicksand.a | build/test
build build/test/sub: link_exe test/test_sub.c build/libquicksand.a | build/test

build build/docs/.stamp: copy_docs docs/README.md docs/windows-mingw.md
build build/docs/quicksand.3: scdoc docs/quicksand.3.scd
build build/quicksand.pc: gen_pc docs/quicksand.pc.in

build build/.check.stamp: delegate_make | build
  target = check
build build/.install_lib.stamp: install_lib | build/libquicksand.so build/libquicksand.a build/quicksand.pc
build build/.install_docs.stamp: install_docs | build/docs/.stamp build/docs/quicksand.3
build build/.uninstall_lib.stamp: uninstall_lib
build build/.uninstall_docs.stamp: uninstall_docs
build .ninja-clean.stamp: do_clean
build compile_commands.json: gen_compdb build.ninja
build build/.tidy.stamp: delegate_make | build
  target = tidy
build build/.clang_analyze.stamp: delegate_make | build
  target = clang-analyze
build build/.fanalyzer.stamp: delegate_make | build
  target = fanalyzer
build build/.sanitize_check.stamp: delegate_make | build
  target = sanitize-check
build build/.analysis.stamp: delegate_make | build
  target = analysis

build all: phony build/libquicksand.so build/libquicksand.a build/test/basic build/test/time build/test/pub build/test/sub
build check: phony build/.check.stamp
build clean: phony .ninja-clean.stamp
build docs: phony build/docs/.stamp build/docs/quicksand.3
build install-lib: phony build/.install_lib.stamp
build install-docs: phony build/.install_docs.stamp
build install: phony build/.install_lib.stamp build/.install_docs.stamp
build uninstall-lib: phony build/.uninstall_lib.stamp
build uninstall-docs: phony build/.uninstall_docs.stamp
build uninstall: phony build/.uninstall_lib.stamp build/.uninstall_docs.stamp
build tidy: phony compile_commands.json build/.tidy.stamp
build clang-analyze: phony build/.clang_analyze.stamp
build fanalyzer: phony build/.fanalyzer.stamp
build sanitize-check: phony build/.sanitize_check.stamp
build analysis: phony build/.analysis.stamp

default all
